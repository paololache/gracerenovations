# Copy to .env.local (git-ignored) and fill in.

# Google reviews section (src/lib/googleReviews.ts)
# Recommended: URL of the Cloud Run function in server/google-reviews.
# The API key stays in Secret Manager. Setup: docs/google-reviews-gcp.md
VITE_GOOGLE_REVIEWS_ENDPOINT=

# Alternative without a backend (key is visible in the browser — restrict it
# to your domain). Ignored when VITE_GOOGLE_REVIEWS_ENDPOINT is set.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACE_ID=

# Lead form endpoint (src/lib/leads.ts), e.g. a Formspree or CRM webhook URL.
VITE_LEAD_ENDPOINT=
